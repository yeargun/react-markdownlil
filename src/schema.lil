import { htmlSchemaBlob, svgSchemaBlob } from "./schema_data.lil";
import { objectHasOwn } from "./host.lil";

JsValue htmlProperty = JS.object();
JsValue htmlNormal = JS.object();
JsValue svgProperty = JS.object();
JsValue svgNormal = JS.object();
bool schemaReady = false;

JsValue hastToReactMap = JS.object(
  "classId",
  "classID",
  "dataType",
  "datatype",
  "itemId",
  "itemID",
  "strokeDashArray",
  "strokeDasharray",
  "strokeDashOffset",
  "strokeDashoffset",
  "strokeLineCap",
  "strokeLinecap",
  "strokeLineJoin",
  "strokeLinejoin",
  "strokeMiterLimit",
  "strokeMiterlimit",
  "typeOf",
  "typeof",
  "xLinkActuate",
  "xlinkActuate",
  "xLinkArcRole",
  "xlinkArcrole",
  "xLinkHref",
  "xlinkHref",
  "xLinkRole",
  "xlinkRole",
  "xLinkShow",
  "xlinkShow",
  "xLinkTitle",
  "xlinkTitle",
  "xLinkType",
  "xlinkType",
  "xmlnsXLink",
  "xmlnsXlink"
);

bool validDataName(string value) {
  if (value.length < 5) {
    return false;
  }
  if (value.toLowerCase().slice(0, 4) != "data") {
    return false;
  }
  int i = 4;
  int n = value.length;
  while (i < n) {
    int c = value.charCodeAt(i);
    bool ok = false;
    if (c >= 48 && c <= 57) {
      ok = true;
    } else if (c >= 65 && c <= 90) {
      ok = true;
    } else if (c >= 97 && c <= 122) {
      ok = true;
    } else if (c == 45 || c == 95 || c == 46 || c == 58) {
      ok = true;
    }
    if (!ok) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

void addLine(JsValue property, JsValue normal, string line) {
  int first = -1;
  int second = -1;
  int i = 0;
  int n = line.length;
  while (i < n) {
    if (line.charAt(i) == "|") {
      if (first < 0) {
        first = i;
      } else if (second < 0) {
        second = i;
      }
    }
    i = i + 1;
  }
  if (first < 0 || second < 0) {
    return;
  }
  string prop = line.slice(0, first);
  string attr = line.slice(first + 1, second);
  string flags = line.slice(second + 1);
  property[prop] = attr + "|" + flags;
  normal[prop.toLowerCase()] = prop;
  normal[attr.toLowerCase()] = prop;
}

void loadBlob(JsValue property, JsValue normal, string blob) {
  int start = 0;
  int n = blob.length;
  int i = 0;
  while (i <= n) {
    if (i == n || blob.charAt(i) == "\n") {
      if (i > start) {
        addLine(property, normal, blob.slice(start, i));
      }
      start = i + 1;
    }
    i = i + 1;
  }
}

void ensureSchema() {
  if (schemaReady) {
    return;
  }
  schemaReady = true;
  loadBlob(htmlProperty, htmlNormal, htmlSchemaBlob);
  loadBlob(svgProperty, svgNormal, svgSchemaBlob);
}

string kebabCap(string ch) {
  return "-" + ch.toLowerCase();
}

string restToKebab(string rest) {
  string out = "";
  int i = 0;
  int n = rest.length;
  while (i < n) {
    string ch = rest.charAt(i);
    int c = rest.charCodeAt(i);
    if (c >= 65 && c <= 90) {
      out = out + kebabCap(ch);
    } else {
      out = out + ch;
    }
    i = i + 1;
  }
  return out;
}

bool hasDashLower(string rest) {
  int i = 0;
  int n = rest.length;
  while (i < n - 1) {
    if (rest.charAt(i) == "-") {
      int c = rest.charCodeAt(i + 1);
      if (c >= 97 && c <= 122) {
        return true;
      }
    }
    i = i + 1;
  }
  return false;
}

string dashToCamelChunk(string rest) {
  string out = "";
  int i = 0;
  int n = rest.length;
  while (i < n) {
    if (i < n - 1 && rest.charAt(i) == "-") {
      int c = rest.charCodeAt(i + 1);
      if (c >= 97 && c <= 122) {
        out = out + rest.charAt(i + 1).toUpperCase();
        i = i + 2;
      } else {
        out = out + rest.charAt(i);
        i = i + 1;
      }
    } else {
      out = out + rest.charAt(i);
      i = i + 1;
    }
  }
  return out;
}

bool isAriaOrRole(string propertyName) {
  if (propertyName == "role") {
    return true;
  }
  if (propertyName.length >= 4 && propertyName.slice(0, 4) == "aria") {
    return true;
  }
  return false;
}

JsValue makeInfo(string propertyName, string attributeName, string flags, string space) {
  bool comma = false;
  int i = 0;
  while (i < flags.length) {
    if (flags.charAt(i) == "c") {
      comma = true;
    }
    i = i + 1;
  }
  return JS.object(
    "propName",
    propertyName,
    "attrName",
    attributeName,
    "space",
    space,
    "commaSeparated",
    comma
  );
}

export JsValue find(string space, string value) {
  ensureSchema();
  JsValue property = htmlProperty;
  JsValue normal = htmlNormal;
  if (space == "svg") {
    property = svgProperty;
    normal = svgNormal;
  }
  string lowered = value.toLowerCase();
  if (objectHasOwn(normal, lowered)) {
    JsValue propVal = JS.get(normal, lowered);
    string prop = "";
    if (propVal is string) {
      prop = propVal;
    }
    JsValue packedVal = JS.get(property, prop);
    string packed = "";
    if (packedVal is string) {
      packed = packedVal;
    }
    int bar = 0;
    while (bar < packed.length) {
      if (packed.charAt(bar) == "|") {
        string foundSpace = space;
      if (isAriaOrRole(prop)) {
        foundSpace = "";
      }
      return makeInfo(prop, packed.slice(0, bar), packed.slice(bar + 1), foundSpace);
      }
      bar = bar + 1;
    }
    string foundSpace = space;
    if (isAriaOrRole(prop)) {
      foundSpace = "";
    }
    return makeInfo(prop, packed, "", foundSpace);
  }
  string propertyName = value;
  string attributeName = value;
  if (lowered.length > 4 && lowered.slice(0, 4) == "data" && validDataName(value)) {
    if (value.length > 4 && value.charAt(4) == "-") {
      string rest = dashToCamelChunk(value.slice(5));
      if (rest.length > 0) {
        propertyName = "data" + rest.charAt(0).toUpperCase() + rest.slice(1);
      } else {
        propertyName = "data";
      }
    } else {
      string rest = value.slice(4);
      if (!hasDashLower(rest)) {
        string dashes = restToKebab(rest);
        if (dashes.length == 0 || dashes.charAt(0) != "-") {
          dashes = "-" + dashes;
        }
        attributeName = "data" + dashes;
      }
    }
    return makeInfo(propertyName, attributeName, "", "");
  }
  return makeInfo(propertyName, attributeName, "", "");
}

export JsValue reactPropertyName(JsValue info) {
  JsValue prop = JS.get(info, "propName");
  if (objectHasOwn(hastToReactMap, JS.string(prop))) {
    return JS.get(hastToReactMap, JS.string(prop));
  }
  return prop;
}
