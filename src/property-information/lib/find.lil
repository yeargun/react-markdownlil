// property-information@7.2.0: the merged `html` and `svg` schemas and `find(schema, value)`, as upstream.
// A schema is upstream's pair of tables: `normal` maps a lowercased property or attribute name to a
// property name, `property` maps a property name to its info; `find` looks names up with `in` (inherited
// names included, as upstream). The tables are built once from the generated rows in schema-data.lil.
import {
  ariaRows, commonOnRows, commonRows, htmlCommaRows, htmlOnRows, htmlRows, noSpaceRows,
  svgCommaRows, svgDashRows, svgLowerRows, svgOnRows, svgRows
} from "./schema-data.lil";

extern JsValue RegExp;

export extern class PropertyInfo {
  string property;
  JsValue attribute;
  JsValue space;
  JsValue commaSeparated;
}

extern class Schema {
  JsValue normal;
  JsValue property;
}

export JsValue html = object { normal: object {}, property: object {} };
export JsValue svg = object { normal: object {}, property: object {} };

JsValue cap = JS.construct(RegExp, "[A-Z]", "g");
JsValue dash = JS.construct(RegExp, "-[a-z]", "g");
JsValue valid = JS.construct(RegExp, "^data[-\\w.:]+$", "i");

JsValue kebab = JS.method1((JsValue _t, JsValue found) => JS.add("-", JS.invoke(found, "toLowerCase")));
export JsValue camelcase = JS.method1((JsValue _t, JsValue found) => JS.invoke(JS.invoke(found, "charAt", 1), "toUpperCase"));

void define(JsValue target, string property, JsValue attribute, bool space, JsValue comma) {
  Schema schema = JS.assume(target);
  schema.property[property] = object { attribute: attribute, property: property, space: space, commaSeparated: comma };
  schema.normal[property.toLowerCase()] = property;
  schema.normal[JS.invoke(attribute, "toLowerCase")] = property;
}

// A group of rows (see schema-data.lil): space-separated `name` or `name|attribute`; the property is `prefix`
// + name, the attribute follows `rule` unless given: 0 the property, 1 its lowercase, 2 its dash-case,
// 3 `aria-` + the lowercased name, 4 the property. Rules 3 and 4 have no space. `only` is the schema to define
// into, or nothing for both.
void load(string rows, int rule, JsValue only, JsValue comma, JsValue prefix) {
  JsValue list = JS.invoke(rows, "split", " ");
  for (float index = 0; index < list.length; index++) {
    JsValue fields = JS.invoke(list[index], "split", "|");
    JsValue name = fields[0];
    string property = JS.assume(JS.add(JS.or(prefix, ""), name));
    JsValue attribute = JS.or(fields[1], if (rule == 3) {
      JS.add("aria-", JS.invoke(name, "toLowerCase"))
    } else {
      if (rule == 2) { JS.invoke(property, "replace", cap, kebab) } else { if (rule == 1) { property.toLowerCase() } else { property } }
    });
    bool space = rule < 3;
    if (only.truthy()) {
      define(only, property, attribute, space, comma);
    } else {
      define(html, property, attribute, space, comma);
      define(svg, property, attribute, space, comma);
    }
  }
}

load(ariaRows, 3, 0, false, "aria");
load(noSpaceRows, 4, JS.undefined(), JS.undefined(), JS.undefined());
load(commonRows, 1, JS.undefined(), JS.undefined(), JS.undefined());
load(commonOnRows, 1, 0, false, "on");
load(htmlRows, 1, html, JS.undefined(), JS.undefined());
load(htmlOnRows, 1, html, false, "on");
load(htmlCommaRows, 1, html, true, JS.undefined());
load(svgRows, 0, svg, JS.undefined(), JS.undefined());
load(svgDashRows, 2, svg, JS.undefined(), JS.undefined());
load(svgLowerRows, 1, svg, JS.undefined(), JS.undefined());
load(svgOnRows, 1, svg, false, "on");
load(svgCommaRows, 0, svg, true, JS.undefined());

export PropertyInfo find(JsValue target, string value) {
  Schema schema = JS.assume(target);
  string normal = value.toLowerCase();
  if (JS.in(normal, schema.normal)) {
    return JS.assume(schema.property[schema.normal[normal]]);
  }
  string property = value;
  // Upstream first checks `normal.length > 4 && normal.slice(0, 4) === 'data'`; `valid` (ASCII only, `data`
  // and at least one more character) implies both.
  if (JS.invoke(valid, "test", value).truthy()) {
    if (value.charAt(4) == "-") {
      string rest = JS.assume(JS.invoke(value.slice(5), "replace", dash, camelcase));
      property = "data" + rest.charAt(0).toUpperCase() + rest.slice(1);
    } else {
      string rest = value.slice(4);
      if (!JS.invoke(dash, "test", rest).truthy()) {
        string dashes = JS.assume(JS.invoke(rest, "replace", cap, kebab));
        if (dashes.charAt(0) != "-") {
          dashes = "-" + dashes;
        }
        value = "data" + dashes;
      }
    }
  }
  // Upstream's Info/DefinedInfo: no space, not comma-separated (both read as falsy).
  return JS.assume(object { attribute: value, property: property });
}


// hast-to-react: React's spelling of 17 properties. Each differs from its property name only in case, and no
// other property with a space shares that lowercase name, so the table is keyed by lowercase name.
export JsValue hastToReact = object {};
JsValue reactNames = JS.invoke("classID datatype itemID strokeDasharray strokeDashoffset strokeLinecap strokeLinejoin strokeMiterlimit typeof xlinkActuate xlinkArcrole xlinkHref xlinkRole xlinkShow xlinkTitle xlinkType xmlnsXlink", "split", " ");
for (float index = 0; index < reactNames.length; index++) {
  hastToReact[JS.invoke(reactNames[index], "toLowerCase")] = reactNames[index];
}

export JsValue reactName(PropertyInfo info) {
  return JS.or(hastToReact[info.property.toLowerCase()], info.property);
}
