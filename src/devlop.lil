// devlop@1.1.0: the development build (`development` true) throws an `AssertionError`-shaped `Error`;
// production does nothing. Every caller passes a message.
import { Error, Object } from "./host.lil";

define bool development = false;

export void unreachable(string message) {
  if (development) {
    throw JS.invoke(Object, "assign", JS.construct(Error, message), object {
      name: "Assertion",
      code: "ERR_ASSERTION",
      actual: false,
      expected: true,
      generated: false,
      operator: "ok"
    });
  }
}
