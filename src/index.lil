import { Markdown, MarkdownAsync, MarkdownHooks, defaultUrlTransform } from "./lib/index.lil";
import { Object } from "./host.lil";

export { MarkdownAsync, MarkdownHooks, defaultUrlTransform };
export JsValue default = Markdown;

// Upstream's `export function Markdown` is the default export; keep its name.
JS.invoke(Object, "defineProperty", Markdown, "name", object { value: "Markdown" });
