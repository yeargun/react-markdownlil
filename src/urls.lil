// html-url-attributes@3.0.1: the attributes react-markdown passes through `urlTransform`, with the elements
// they apply to (`0`: every element; upstream's `null`).
export JsValue urlAttributes = object {
  action: ["form"],
  cite: ["blockquote", "del", "ins", "q"],
  data: ["object"],
  formAction: ["button", "input"],
  href: ["a", "area", "base", "link"],
  icon: ["menuitem"],
  itemId: 0,
  manifest: ["html"],
  ping: ["a", "area"],
  poster: ["video"],
  src: ["audio", "embed", "iframe", "img", "input", "script", "source", "track", "video"]
};
