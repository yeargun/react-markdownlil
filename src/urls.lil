export struct UrlAttribute {
  string property;
  string[] elements;
  bool allElements;
}

export UrlAttribute[] urlAttributes = [
  UrlAttribute{"action", ["form"], false},
  UrlAttribute{"cite", ["blockquote", "del", "ins", "q"], false},
  UrlAttribute{"data", ["object"], false},
  UrlAttribute{"formAction", ["button", "input"], false},
  UrlAttribute{"href", ["a", "area", "base", "link"], false},
  UrlAttribute{"icon", ["menuitem"], false},
  UrlAttribute{"itemId", [], true},
  UrlAttribute{"manifest", ["html"], false},
  UrlAttribute{"ping", ["a", "area"], false},
  UrlAttribute{"poster", ["video"], false},
  UrlAttribute{"src", ["audio", "embed", "iframe", "img", "input", "script", "source", "track", "video"], false}
];
