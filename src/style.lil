
string capitalizeHyphen(string piece) {
  if (piece.length < 2) {
    return piece;
  }
  return piece.charAt(1).toUpperCase();
}

bool isCustomProperty(string property) {
  if (property.length < 2) {
    return false;
  }
  return property.charAt(0) == "-" && property.charAt(1) == "-";
}

bool hasHyphen(string property) {
  int i = 0;
  while (i < property.length) {
    if (property.charAt(i) == "-") {
      return true;
    }
    i = i + 1;
  }
  return false;
}

string replaceHyphens(string property) {
  string out = "";
  int i = 0;
  int n = property.length;
  while (i < n) {
    if (i < n - 1 && property.charAt(i) == "-") {
      int c = property.charCodeAt(i + 1);
      if (c >= 97 && c <= 122) {
        out = out + property.charAt(i + 1).toUpperCase();
        i = i + 2;
      } else {
        out = out + property.charAt(i);
        i = i + 1;
      }
    } else {
      out = out + property.charAt(i);
      i = i + 1;
    }
  }
  return out;
}

bool startsWithMsVendor(string property) {
  if (property.length < 4) {
    return false;
  }
  return property.slice(0, 4) == "-ms-";
}

export string camelCase(string property, bool reactCompat) {
  if (property.length == 0) {
    return property;
  }
  if (isCustomProperty(property)) {
    return property;
  }
  if (!hasHyphen(property)) {
    return property;
  }
  string next = property.toLowerCase();
  if (reactCompat) {
    if (startsWithMsVendor(next)) {
      next = "ms-" + next.slice(4);
    }
  } else {
    if (next.length > 1 && next.charAt(0) == "-") {
      int i = 1;
      while (i < next.length && next.charAt(i) != "-") {
        i = i + 1;
      }
      if (i < next.length) {
        next = next.slice(1);
      }
    }
  }
  return replaceHyphens(next);
}

string trimAscii(string value) {
  int a = 0;
  int b = value.length;
  while (a < b) {
    int c = value.charCodeAt(a);
    if (c != 32 && c != 9 && c != 10 && c != 13 && c != 12) {
      break;
    }
    a = a + 1;
  }
  while (b > a) {
    int c = value.charCodeAt(b - 1);
    if (c != 32 && c != 9 && c != 10 && c != 13 && c != 12) {
      break;
    }
    b = b - 1;
  }
  if (b > a) {
    return value.slice(a, b);
  }
  return "";
}

void pushDecl(JsValue decls, string chunk) {
  int colon = chunk.indexOf(":");
  if (colon < 1) {
    return;
  }
  string property = trimAscii(chunk.slice(0, colon));
  string value = trimAscii(chunk.slice(colon + 1));
  if (property.length > 0 && value.length > 0) {
    JsValue decl = JS.array();
    JS.push(decl, property);
    JS.push(decl, value);
    JS.push(decls, decl);
  }
}

JsValue parseDeclarations(string style) {
  JsValue decls = JS.array();
  string chunk = "";
  int n = style.length;
  int i = 0;
  while (i < n) {
    string ch = style.charAt(i);
    if (ch == ";") {
      pushDecl(decls, chunk);
      chunk = "";
    } else {
      chunk = chunk + ch;
    }
    i = i + 1;
  }
  pushDecl(decls, chunk);
  return decls;
}

export JsValue styleToJs(string style, bool reactCompat) {
  JsValue output = JS.object();
  if (style.length == 0) {
    return output;
  }
  JsValue decls = parseDeclarations(style);
  int n = decls.length.toInt();
  int i = 0;
  while (i < n) {
    JsValue decl = decls[i];
    string property = "";
    string value = "";
    JsValue p = decl[0];
    JsValue v = decl[1];
    if (p is string) {
      property = p;
    }
    if (v is string) {
      value = v;
    }
    if (property.length > 0 && value.length > 0) {
      output[camelCase(property, reactCompat)] = value;
    }
    i = i + 1;
  }
  return output;
}

export JsValue parseStyle(string value, bool ignoreInvalid) {
  return styleToJs(value, true);
}
