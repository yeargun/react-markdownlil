// hast-util-to-jsx-runtime@2.3.6 `toJsxRuntime(tree, options)` for the options react-markdown passes:
// {Fragment, components, ignoreInvalidStyle: true, jsx, jsxs, passKeys: true, passNode: true} (production
// `create`, React attribute and DOM style casing, table-cell `align` moved to `style`).
import { Map, Object } from "../../host.lil";
import { PropertyInfo, find, html, reactName, svg } from "../../property-information/lib/find.lil";
import { styleToJs } from "../../style-to-js/index.lil";
import { createVFileMessage } from "../../vfile/lib/index.lil";

export extern JsValue Fragment;
export extern JsValue jsx;
export extern JsValue jsxs;
extern JsValue Number;
extern JsValue RegExp;
extern JsValue String;

extern class State {
  JsValue ancestors;
  JsValue components;
  JsValue schema;
}

JsValue identifierName = JS.construct(RegExp, "^[$_\\p{ID_Start}][$_\\u200C\\u200D\\p{ID_Continue}]*$", "u");
JsValue lowercaseStart = JS.construct(RegExp, "^[a-z]");
JsValue whitespaceOnly = JS.construct(RegExp, "^[ \\t\\n\\f\\r]*$");

export JsValue toJsxRuntime(JsValue tree, JsValue components) {
  State state = JS.assume(object {
    ancestors: JS.array(),
    components: JS.or(components, object {}),
    schema: html
  });
  JsValue result = one(state, tree, JS.undefined());
  if (result.truthy() && JS.typeOf(result) != "string") {
    return result;
  }
  return create(Fragment, object { children: JS.or(result, JS.undefined()) }, JS.undefined());
}

JsValue one(State state, JsValue node, JsValue key) {
  JsValue type = JS.get(node, "type");
  if (JS.strictEqual(type, "element")) {
    return element(state, node, key);
  }
  if (JS.strictEqual(type, "mdxFlowExpression") || JS.strictEqual(type, "mdxTextExpression") || JS.strictEqual(type, "mdxjsEsm")) {
    crashEstree(state, JS.get(node, "position"));
  }
  if (JS.strictEqual(type, "mdxJsxFlowElement") || JS.strictEqual(type, "mdxJsxTextElement")) {
    return mdxJsxElement(state, node, key);
  }
  if (JS.strictEqual(type, "root")) {
    JsValue props = object {};
    addChildren(props, createChildren(state, node));
    return create(Fragment, props, key);
  }
  if (JS.strictEqual(type, "text")) {
    return JS.get(node, "value");
  }
  return JS.undefined();
}

JsValue element(State state, JsValue node, JsValue key) {
  JsValue parentSchema = state.schema;
  if (JS.strictEqual(JS.invoke(JS.get(node, "tagName"), "toLowerCase"), "svg") && JS.strictEqual(parentSchema, html)) {
    state.schema = svg;
  }
  JS.invoke(state.ancestors, "push", node);
  JsValue type = findComponentFromName(state, JS.get(node, "tagName"), false);
  JsValue props = object {};
  JsValue alignValue = JS.undefined();
  for (string prop in JS.get(node, "properties")) {
    if (prop != "children" && JS.invoke(Object, "hasOwn", JS.get(node, "properties"), prop).truthy()) {
      JsValue value = JS.get(JS.get(node, "properties"), prop);
      PropertyInfo info = find(state.schema, prop);
      // `value === null || value === undefined || (typeof value === 'number' && Number.isNaN(value))` skips it.
      if (!JS.isNullish(value) && JS.strictEqual(value, value)) {
        if (value.isArray()) {
          // comma-separated-tokens / space-separated-tokens `stringify`
          if (info.commaSeparated.truthy()) {
            if (JS.strictEqual(value[value.length - 1], "")) {
              value = JS.invoke(value, "concat", "");
            }
            value = JS.invoke(JS.invoke(value, "join", ", "), "trim");
          } else {
            value = JS.invoke(JS.invoke(value, "join", " "), "trim");
          }
        }
        if (JS.strictEqual(info.property, "style")) {
          if (JS.typeOf(value) != "object") {
            value = styleToJs(JS.call(String, JS.undefined(), value));
          }
          props["style"] = value;
        } else {
          JsValue name = if (info.space.truthy()) { reactName(info) } else { info.attribute };
          if (JS.strictEqual(name, "align") && JS.typeOf(value) == "string" && (JS.strictEqual(JS.get(node, "tagName"), "td") || JS.strictEqual(JS.get(node, "tagName"), "th"))) {
            alignValue = value;
          } else {
            props[name] = value;
          }
        }
      }
    }
  }
  if (alignValue.truthy()) {
    JsValue style = JS.get(props, "style");
    if (!style.truthy()) {
      style = object {};
      props["style"] = style;
    }
    style["textAlign"] = alignValue;
  }
  JsValue children = createChildren(state, node);
  JsValue tag = JS.get(node, "tagName");
  if (JS.strictEqual(tag, "table") || JS.strictEqual(tag, "tbody") || JS.strictEqual(tag, "thead") || JS.strictEqual(tag, "tfoot") || JS.strictEqual(tag, "tr")) {
    children = JS.invoke(children, "filter", JS.method1((JsValue _t, JsValue child) => {
      return JS.typeOf(child) != "string" || !JS.invoke(whitespaceOnly, "test", child).truthy();
    }));
  }
  return finish(state, node, type, props, children, parentSchema, key);
}

JsValue mdxJsxElement(State state, JsValue node, JsValue key) {
  JsValue parentSchema = state.schema;
  if (JS.strictEqual(JS.get(node, "name"), "svg") && JS.strictEqual(parentSchema, html)) {
    state.schema = svg;
  }
  JS.invoke(state.ancestors, "push", node);
  JsValue type = if (JS.strictEqual(JS.get(node, "name"), JS.assume(null))) { Fragment } else { findComponentFromName(state, JS.get(node, "name"), true) };
  JsValue props = object {};
  JsValue attributes = JS.get(node, "attributes");
  for (float index = 0; index < attributes.length; index++) {
    JsValue attribute = attributes[index];
    if (JS.strictEqual(JS.get(attribute, "type"), "mdxJsxExpressionAttribute")) {
      crashEstree(state, JS.get(node, "position"));
    } else {
      JsValue name = JS.get(attribute, "name");
      JsValue value = JS.get(attribute, "value");
      if (value.truthy() && JS.typeOf(value) == "object") {
        crashEstree(state, JS.get(node, "position"));
      }
      props[name] = if (JS.strictEqual(value, JS.assume(null))) { true } else { value };
    }
  }
  return finish(state, node, type, props, createChildren(state, node), parentSchema, key);
}

JsValue finish(State state, JsValue node, JsValue type, JsValue props, JsValue children, JsValue parentSchema, JsValue key) {
  if (JS.typeOf(type) != "string" && !JS.strictEqual(type, Fragment)) {
    props["node"] = node;
  }
  addChildren(props, children);
  JS.invoke(state.ancestors, "pop");
  state.schema = parentSchema;
  return create(type, props, key);
}

void addChildren(JsValue props, JsValue children) {
  if (children.length > 0) {
    JsValue value = if (children.length > 1) { children } else { children[0] };
    if (value.truthy()) {
      props["children"] = value;
    }
  }
}

JsValue create(JsValue type, JsValue props, JsValue key) {
  JsValue fn = if (JS.get(props, "children").isArray()) { jsxs } else { jsx };
  if (key.truthy()) {
    return JS.call(fn, JS.undefined(), type, props, key);
  }
  return JS.call(fn, JS.undefined(), type, props);
}

JsValue createChildren(State state, JsValue node) {
  JsValue children = JS.array();
  JsValue countsByName = JS.construct(Map);
  for (float index = 0; index < JS.get(node, "children").length; index++) {
    JsValue child = JS.get(node, "children")[index];
    JsValue key = JS.undefined();
    JsValue name = if (JS.strictEqual(JS.get(child, "type"), "element")) {
      JS.get(child, "tagName")
    } else {
      if (JS.strictEqual(JS.get(child, "type"), "mdxJsxFlowElement") || JS.strictEqual(JS.get(child, "type"), "mdxJsxTextElement")) { JS.get(child, "name") } else { JS.undefined() }
    };
    if (name.truthy()) {
      JsValue count = JS.or(JS.invoke(countsByName, "get", name), 0);
      key = JS.add(JS.add(name, "-"), count);
      JS.invoke(countsByName, "set", name, JS.add(count, 1));
    }
    JsValue result = one(state, child, key);
    if (!JS.isUndefined(result)) {
      JS.invoke(children, "push", result);
    }
  }
  return children;
}

JsValue findComponentFromName(State state, JsValue name, bool allowExpression) {
  if (allowExpression && (JS.invoke(name, "includes", ".").truthy() || JS.invoke(identifierName, "test", name).truthy() && !JS.invoke(lowercaseStart, "test", name).truthy())) {
    crashEstree(state, JS.undefined());
  }
  if (JS.invoke(Object, "hasOwn", state.components, name).truthy()) {
    return state.components[name];
  }
  return name;
}

void crashEstree(State state, JsValue place) {
  JsValue message = createVFileMessage("Cannot handle MDX estrees without `createEvaluater`", object {
    ancestors: state.ancestors,
    place: place,
    ruleId: "mdx-estree",
    source: "hast-util-to-jsx-runtime"
  });
  message["file"] = JS.undefined();
  message["url"] = "https://github.com/syntax-tree/hast-util-to-jsx-runtime#cannot-handle-mdx-estrees-without-createevaluater";
  throw message;
}
