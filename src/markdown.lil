import { Object, Promise, objectHasOwn, setIndex, throwError } from "./host.lil";
import { toJsxRuntime } from "./jsx.lil";
import { urlAttributes } from "./urls.lil";
import { visit } from "./visit.lil";
import { VFile } from "./vfile.lil";

export extern JsValue unified;
export extern JsValue remarkParse;
export extern JsValue remarkRehype;
export extern JsValue Fragment;
export extern JsValue jsx;
export extern JsValue jsxs;
export extern JsValue useMemo;
export extern JsValue useState;
export extern JsValue useEffect;

string changelog = "https://github.com/remarkjs/react-markdown/blob/main/changelog.md";
JsValue emptyPlugins = JS.array();
JsValue emptyRemarkRehypeOptions = JS.object("allowDangerousHtml", true);

JsValue deprecations = JS.array();

void addDep(string from, string id, string to) {
  JsValue row = JS.object();
  row["from"] = from;
  row["id"] = id;
  if (to.length > 0) {
    row["to"] = to;
  }
  JS.push(deprecations, row);
}

void initDeprecations() {
  addDep("astPlugins", "remove-buggy-html-in-markdown-parser", "");
  addDep("allowDangerousHtml", "remove-buggy-html-in-markdown-parser", "");
  addDep("allowNode", "replace-allownode-allowedtypes-and-disallowedtypes", "allowElement");
  addDep("allowedTypes", "replace-allownode-allowedtypes-and-disallowedtypes", "allowedElements");
  addDep("className", "remove-classname", "");
  addDep("disallowedTypes", "replace-allownode-allowedtypes-and-disallowedtypes", "disallowedElements");
  addDep("escapeHtml", "remove-buggy-html-in-markdown-parser", "");
  addDep("includeElementIndex", "#remove-includeelementindex", "");
  addDep("includeNodeIndex", "change-includenodeindex-to-includeelementindex", "");
  addDep("linkTarget", "remove-linktarget", "");
  addDep("plugins", "change-plugins-to-remarkplugins", "remarkPlugins");
  addDep("rawSourcePos", "#remove-rawsourcepos", "");
  addDep("renderers", "change-renderers-to-components", "components");
  addDep("source", "change-source-to-children", "children");
  addDep("sourcePos", "#remove-sourcepos", "");
  addDep("transformImageUri", "#add-urltransform", "urlTransform");
  addDep("transformLinkUri", "#add-urltransform", "urlTransform");
}

initDeprecations();

bool protocolAllowed(string value, int colon) {
  string proto = value.slice(0, colon).toLowerCase();
  return proto == "http" || proto == "https" || proto == "irc" || proto == "ircs" || proto == "mailto" || proto == "xmpp";
}

JsValue defaultUrlTransformCall(JsValue _self, JsValue raw) {
  string value = JS.string(raw);
  int colon = value.indexOf(":");
  int questionMark = value.indexOf("?");
  int numberSign = value.indexOf("#");
  int slash = value.indexOf("/");
  if (colon == -1) {
    return value;
  }
  if (slash != -1 && colon > slash) {
    return value;
  }
  if (questionMark != -1 && colon > questionMark) {
    return value;
  }
  if (numberSign != -1 && colon > numberSign) {
    return value;
  }
  if (protocolAllowed(value, colon)) {
    return value;
  }
  return "";
}

export JsValue defaultUrlTransform = JS.method1(defaultUrlTransformCall);

void assignOwn(JsValue target, JsValue source) {
  if (JS.isUndefined(source) || JS.isNullish(source) || JS.typeOf(source) != "object") {
    return;
  }
  for (string key in source) {
    target[key] = JS.get(source, key);
  }
}

JsValue createProcessor(JsValue options) {
  JsValue rehypePlugins = JS.get(options, "rehypePlugins");
  if (!rehypePlugins.truthy()) {
    rehypePlugins = emptyPlugins;
  }
  JsValue remarkPlugins = JS.get(options, "remarkPlugins");
  if (!remarkPlugins.truthy()) {
    remarkPlugins = emptyPlugins;
  }
  JsValue remarkRehypeOptions = emptyRemarkRehypeOptions;
  JsValue extra = JS.get(options, "remarkRehypeOptions");
  if (extra.truthy()) {
    JsValue merged = JS.object();
    assignOwn(merged, extra);
    assignOwn(merged, emptyRemarkRehypeOptions);
    remarkRehypeOptions = merged;
  }
  JsValue processor = JS.call(unified, JS.undefined());
  processor = JS.call(JS.get(processor, "use"), processor, remarkParse);
  processor = JS.call(JS.get(processor, "use"), processor, remarkPlugins);
  processor = JS.call(JS.get(processor, "use"), processor, remarkRehype, remarkRehypeOptions);
  processor = JS.call(JS.get(processor, "use"), processor, rehypePlugins);
  return processor;
}

JsValue createFile(JsValue options) {
  JsValue children = JS.get(options, "children");
  if (!children.truthy()) {
    children = "";
  }
  JsValue file = JS.construct(VFile);
  if (JS.typeOf(children) == "string") {
    file["value"] = children;
    return file;
  }
  throwError("Unexpected value `" + JS.string(children) + "` for `children` prop, expected `string`");
  return file;
}

void checkDeprecations(JsValue options) {
  int i = 0;
  int n = deprecations.length.toInt();
  while (i < n) {
    JsValue deprecation = deprecations[i];
    string from = JS.string(JS.get(deprecation, "from"));
    if (objectHasOwn(options, from)) {
      string hint = "remove it";
      if (objectHasOwn(deprecation, "to")) {
        hint = "use `" + JS.string(JS.get(deprecation, "to")) + "` instead";
      }
      throwError(
        "Unexpected `" +
          from +
          "` prop, " +
          hint +
          " (see <" +
          changelog +
          "#" +
          JS.string(JS.get(deprecation, "id")) +
          "> for more info)"
      );
    }
    i = i + 1;
  }
}

void spliceRemove(JsValue kids, int index) {
  JS.invoke(kids, "splice", index, 1);
}

void spliceUnwrap(JsValue kids, int index, JsValue nodeChildren) {
  JsValue args = JS.array();
  JS.push(args, index);
  JS.push(args, 1);
  if (JS.isArray(nodeChildren)) {
    int i = 0;
    int n = nodeChildren.length.toInt();
    while (i < n) {
      JS.push(args, nodeChildren[i]);
      i = i + 1;
    }
  }
  JS.apply(JS.get(kids, "splice"), kids, args);
}

JsValue post(JsValue tree, JsValue options) {
  checkDeprecations(options);
  JsValue allowedElements = JS.get(options, "allowedElements");
  JsValue allowElement = JS.get(options, "allowElement");
  JsValue components = JS.get(options, "components");
  JsValue disallowedElements = JS.get(options, "disallowedElements");
  JsValue skipHtml = JS.get(options, "skipHtml");
  JsValue unwrapDisallowed = JS.get(options, "unwrapDisallowed");
  JsValue urlTransform = JS.get(options, "urlTransform");
  if (!urlTransform.truthy()) {
    urlTransform = defaultUrlTransform;
  }
  if (allowedElements.truthy() && disallowedElements.truthy()) {
    throwError("Unexpected combined `allowedElements` and `disallowedElements`, expected one or the other");
  }
  JsValue transform = JS.method3((JsValue _s, JsValue node, JsValue index, JsValue parent) => {
    if (JS.string(JS.get(node, "type")) == "raw" && parent.truthy() && JS.typeOf(index) == "number") {
      if (skipHtml.truthy()) {
        spliceRemove(JS.get(parent, "children"), JS.number(index).toInt());
      } else {
        JsValue text = JS.object();
        text["type"] = "text";
        text["value"] = JS.get(node, "value");
        setIndex(JS.get(parent, "children"), JS.number(index).toInt(), text);
      }
      return index;
    }
    if (JS.string(JS.get(node, "type")) == "element") {
      JsValue properties = JS.get(node, "properties");
      if (JS.isUndefined(properties) || JS.isNullish(properties)) {
        properties = JS.object();
        node["properties"] = properties;
      }
      for (string key in urlAttributes) {
        if (objectHasOwn(urlAttributes, key) && objectHasOwn(properties, key)) {
          JsValue value = JS.get(properties, key);
          JsValue test = JS.get(urlAttributes, key);
          bool applies = JS.isNullish(test);
          if (!applies && JS.isArray(test)) {
            applies = JS.invoke(test, "includes", JS.get(node, "tagName")).truthy();
          }
          if (applies) {
            string raw = "";
            if (value.truthy()) {
              raw = JS.string(value);
            }
            properties[key] = JS.call(urlTransform, JS.undefined(), raw, key, node);
          }
        }
      }
      bool remove = false;
      if (allowedElements.truthy()) {
        remove = !JS.invoke(allowedElements, "includes", JS.get(node, "tagName")).truthy();
      } else if (disallowedElements.truthy()) {
        remove = JS.invoke(disallowedElements, "includes", JS.get(node, "tagName")).truthy();
      }
      if (!remove && allowElement.truthy() && JS.typeOf(index) == "number") {
        remove = !JS.call(allowElement, JS.undefined(), node, index, parent).truthy();
      }
      if (remove && parent.truthy() && JS.typeOf(index) == "number") {
        if (unwrapDisallowed.truthy() && JS.get(node, "children").truthy()) {
          spliceUnwrap(JS.get(parent, "children"), JS.number(index).toInt(), JS.get(node, "children"));
        } else {
          spliceRemove(JS.get(parent, "children"), JS.number(index).toInt());
        }
        return index;
      }
    }
    return JS.undefined();
  });
  JS.call(visit, JS.undefined(), tree, transform);
  JsValue runtime = JS.object();
  runtime["Fragment"] = Fragment;
  runtime["components"] = components;
  runtime["ignoreInvalidStyle"] = true;
  runtime["jsx"] = jsx;
  runtime["jsxs"] = jsxs;
  runtime["passKeys"] = true;
  runtime["passNode"] = true;
  return JS.call(toJsxRuntime, JS.undefined(), tree, runtime);
}

JsValue MarkdownCall(JsValue _self, JsValue options) {
  JsValue processor = createProcessor(options);
  JsValue file = createFile(options);
  JsValue parsed = JS.call(JS.get(processor, "parse"), processor, file);
  JsValue tree = JS.call(JS.get(processor, "runSync"), processor, parsed, file);
  return post(tree, options);
}

JsValue MarkdownAsyncCall(JsValue _self, JsValue options) {
  JsValue processor = createProcessor(options);
  JsValue file = createFile(options);
  JsValue parsed = JS.call(JS.get(processor, "parse"), processor, file);
  JsValue ran = JS.call(JS.get(processor, "run"), processor, parsed, file);
  JsValue resolved = JS.call(JS.get(Promise, "resolve"), Promise, ran);
  return JS.call(JS.get(resolved, "then"), resolved, JS.method1((JsValue _s, JsValue tree) => {
    return post(tree, options);
  }));
}

JsValue MarkdownHooksCall(JsValue _self, JsValue options) {
  JsValue deps = JS.array();
  JS.push(deps, JS.get(options, "rehypePlugins"));
  JS.push(deps, JS.get(options, "remarkPlugins"));
  JS.push(deps, JS.get(options, "remarkRehypeOptions"));
  JsValue processor = JS.call(useMemo, JS.undefined(), JS.method0((JsValue _m) => {
    return createProcessor(options);
  }), deps);
  JsValue errorState = JS.call(useState, JS.undefined(), JS.undefined());
  JsValue setError = errorState[1];
  JsValue error = errorState[0];
  JsValue treeState = JS.call(useState, JS.undefined(), JS.undefined());
  JsValue setTree = treeState[1];
  JsValue tree = treeState[0];
  JsValue effectDeps = JS.array();
  JS.push(effectDeps, JS.get(options, "children"));
  JS.push(effectDeps, processor);
  JS.call(useEffect, JS.undefined(), JS.method0((JsValue _e) => {
    JsValue box = JS.object("cancelled", false);
    JsValue file = createFile(options);
    JS.call(JS.get(processor, "run"), processor, JS.call(JS.get(processor, "parse"), processor, file), file, JS.method2((JsValue _s, JsValue nextError, JsValue nextTree) => {
      if (!JS.get(box, "cancelled").truthy()) {
        JS.call(setError, JS.undefined(), nextError);
        JS.call(setTree, JS.undefined(), nextTree);
      }
      return JS.undefined();
    }));
    return JS.method0((JsValue _c) => {
      box["cancelled"] = true;
      return JS.undefined();
    });
  }), effectDeps);
  if (error.truthy()) {
    throw error;
  }
  if (tree.truthy()) {
    return post(tree, options);
  }
  return JS.get(options, "fallback");
}

export JsValue Markdown = JS.method1(MarkdownCall);
export JsValue MarkdownAsync = JS.method1(MarkdownAsyncCall);
export JsValue MarkdownHooks = JS.method1(MarkdownHooksCall);
export JsValue default = Markdown;
