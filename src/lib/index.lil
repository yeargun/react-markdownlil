// react-markdown@10.1.0 `lib/index.js`. Every read of `options` happens in upstream's order (the getter
// trace is part of the behaviour: createProcessor, createFile, then post).
import { Object, RegExp, String } from "../host.lil";
import { unreachable } from "../devlop.lil";
import { unified } from "../graph/unified/entry.lil";
import { default as remarkParse } from "../graph/remark-parse/entry.lil";
import { default as remarkRehype } from "../graph/remark-rehype/entry.lil";
import { toJsxRuntime } from "../hast-util-to-jsx-runtime/lib/index.lil";
import { urlAttributes } from "../urls.lil";
import { visit } from "../unist-util-visit/lib/index.lil";
import { VFile } from "../vfile/lib/index.lil";

export extern JsValue useState;
export extern JsValue useEffect;

JsValue[] emptyPlugins = [];
JsValue emptyRemarkRehypeOptions = object { allowDangerousHtml: true };
JsValue safeProtocol = JS.construct(RegExp, "^(https?|ircs?|mailto|xmpp)$", "i");

// Upstream's deprecation table as `from:id` or `from:id:to` rows.
JsValue deprecations = JS.invoke("astPlugins:remove-buggy-html-in-markdown-parser allowDangerousHtml:remove-buggy-html-in-markdown-parser allowNode:replace-allownode-allowedtypes-and-disallowedtypes:allowElement allowedTypes:replace-allownode-allowedtypes-and-disallowedtypes:allowedElements className:remove-classname disallowedTypes:replace-allownode-allowedtypes-and-disallowedtypes:disallowedElements escapeHtml:remove-buggy-html-in-markdown-parser includeElementIndex:#remove-includeelementindex includeNodeIndex:change-includenodeindex-to-includeelementindex linkTarget:remove-linktarget plugins:change-plugins-to-remarkplugins:remarkPlugins rawSourcePos:#remove-rawsourcepos renderers:change-renderers-to-components:components source:change-source-to-children:children sourcePos:#remove-sourcepos transformImageUri:#add-urltransform:urlTransform transformLinkUri:#add-urltransform:urlTransform", "split", " ");

export JsValue Markdown(JsValue options) {
  JsValue processor = createProcessor(options);
  JsValue file = createFile(options);
  return post(JS.invoke(processor, "runSync", JS.invoke(processor, "parse", file), file), options);
}

export async JsValue MarkdownAsync(JsValue options) {
  JsValue processor = createProcessor(options);
  JsValue file = createFile(options);
  Task<JsValue> ran = JS.assume(JS.invoke(processor, "run", JS.invoke(processor, "parse", file), file));
  return post(await ran, options);
}

export JsValue MarkdownHooks(JsValue options) {
  JsValue processor = createProcessor(options);
  JsValue errorState = JS.call(useState, JS.undefined(), JS.undefined());
  JsValue setError = errorState[1];
  JsValue treeState = JS.call(useState, JS.undefined(), JS.undefined());
  JsValue setTree = treeState[1];
  JS.call(useEffect, JS.undefined(), JS.method0((JsValue _e) => {
    bool cancelled = false;
    JsValue file = createFile(options);
    JS.invoke(processor, "run", JS.invoke(processor, "parse", file), file, JS.method2((JsValue _s, JsValue error, JsValue tree) => {
      if (!cancelled) {
        JS.call(setError, JS.undefined(), error);
        JS.call(setTree, JS.undefined(), tree);
      }
      return JS.undefined();
    }));
    return JS.method0((JsValue _c) => {
      cancelled = true;
      return JS.undefined();
    });
  }), [
    JS.get(options, "children"),
    JS.get(options, "rehypePlugins"),
    JS.get(options, "remarkPlugins"),
    JS.get(options, "remarkRehypeOptions")
  ]);
  if (errorState[0].truthy()) {
    throw errorState[0];
  }
  JsValue tree = treeState[0];
  if (tree.truthy()) {
    return post(tree, options);
  }
  return JS.get(options, "fallback");
}

JsValue createProcessor(JsValue options) {
  JsValue rehypePlugins = JS.or(JS.get(options, "rehypePlugins"), emptyPlugins);
  JsValue remarkPlugins = JS.or(JS.get(options, "remarkPlugins"), emptyPlugins);
  JsValue remarkRehypeOptions = emptyRemarkRehypeOptions;
  if (JS.get(options, "remarkRehypeOptions").truthy()) {
    // `{...options.remarkRehypeOptions, ...emptyRemarkRehypeOptions}`: assigning into a null-prototype object
    // defines every key (an own `__proto__` too), as spread does; the copy then gets spread's prototype.
    remarkRehypeOptions = JS.invoke(Object, "setPrototypeOf",
      JS.invoke(Object, "assign", JS.invoke(Object, "create", JS.assume(null)), JS.get(options, "remarkRehypeOptions"), emptyRemarkRehypeOptions),
      JS.get(Object, "prototype"));
  }
  JsValue processor = JS.call(unified, JS.undefined());
  return JS.invoke(JS.invoke(JS.invoke(JS.invoke(processor, "use", remarkParse), "use", remarkPlugins), "use", remarkRehype, remarkRehypeOptions), "use", rehypePlugins);
}

JsValue createFile(JsValue options) {
  JsValue children = JS.or(JS.get(options, "children"), "");
  JsValue file = JS.construct(VFile);
  if (JS.typeOf(children) == "string") {
    file["value"] = children;
  } else {
    unreachable("Unexpected value `" + children + "` for `children` prop, expected `string`");
  }
  return file;
}

JsValue post(JsValue tree, JsValue options) {
  JsValue allowedElements = JS.get(options, "allowedElements");
  JsValue allowElement = JS.get(options, "allowElement");
  JsValue components = JS.get(options, "components");
  JsValue disallowedElements = JS.get(options, "disallowedElements");
  JsValue skipHtml = JS.get(options, "skipHtml");
  JsValue unwrapDisallowed = JS.get(options, "unwrapDisallowed");
  JsValue urlTransform = JS.or(JS.get(options, "urlTransform"), defaultUrlTransform);

  for (float index = 0; index < deprecations.length; index++) {
    JsValue deprecation = JS.invoke(deprecations[index], "split", ":");
    if (JS.invoke(Object, "hasOwn", options, deprecation[0]).truthy()) {
      JsValue to = deprecation[2];
      unreachable(
        "Unexpected `" + deprecation[0] + "` prop, " +
          (if (to.truthy()) { "use `" + to + "` instead" } else { "remove it" }) +
          " (see <https://github.com/remarkjs/react-markdown/blob/main/changelog.md#" + deprecation[1] + "> for more info)"
      );
    }
  }

  if (allowedElements.truthy() && disallowedElements.truthy()) {
    unreachable("Unexpected combined `allowedElements` and `disallowedElements`, expected one or the other");
  }

  visit(tree, JS.undefined(), (JsValue node, JsValue index, JsValue parent) => {
    bool numeric = JS.typeOf(index) == "number";
    if (JS.strictEqual(JS.get(node, "type"), "raw") && parent.truthy() && numeric) {
      if (skipHtml.truthy()) {
        JS.invoke(JS.get(parent, "children"), "splice", index, 1);
      } else {
        JsValue children = JS.get(parent, "children");
        children[index] = object { type: "text", value: JS.get(node, "value") };
      }
      return index;
    }

    if (JS.strictEqual(JS.get(node, "type"), "element")) {
      for (string key in urlAttributes) {
        if (JS.invoke(Object, "hasOwn", urlAttributes, key).truthy() && JS.invoke(Object, "hasOwn", JS.get(node, "properties"), key).truthy()) {
          JsValue value = JS.get(JS.get(node, "properties"), key);
          JsValue test = JS.get(urlAttributes, key);
          if (!test.truthy() || JS.invoke(test, "includes", JS.get(node, "tagName")).truthy()) {
            JsValue properties = JS.get(node, "properties");
            properties[key] = JS.call(urlTransform, JS.undefined(), JS.call(String, JS.undefined(), JS.or(value, "")), key, node);
          }
        }
      }
    }

    if (JS.strictEqual(JS.get(node, "type"), "element")) {
      JsValue remove = if (allowedElements.truthy()) {
        !JS.invoke(allowedElements, "includes", JS.get(node, "tagName")).truthy()
      } else {
        JS.and(disallowedElements, JS.invoke(disallowedElements, "includes", JS.get(node, "tagName")))
      };
      if (!remove.truthy() && allowElement.truthy() && numeric) {
        remove = !JS.call(allowElement, JS.undefined(), node, index, parent).truthy();
      }
      if (remove.truthy() && parent.truthy() && numeric) {
        JsValue children = JS.get(parent, "children");
        if (unwrapDisallowed.truthy() && JS.get(node, "children").truthy()) {
          JS.apply(JS.get(children, "splice"), children, JS.invoke(JS.array(index, 1), "concat", JS.get(node, "children")));
        } else {
          JS.invoke(children, "splice", index, 1);
        }
        return index;
      }
    }
    return JS.undefined();
  });

  return toJsxRuntime(tree, components);
}

export JsValue defaultUrlTransform(JsValue value) {
  JsValue colon = JS.invoke(value, "indexOf", ":");
  JsValue questionMark = JS.invoke(value, "indexOf", "?");
  JsValue numberSign = JS.invoke(value, "indexOf", "#");
  JsValue slash = JS.invoke(value, "indexOf", "/");
  if (
    JS.strictEqual(colon, -1) ||
    !JS.strictEqual(slash, -1) && JS.greaterThan(colon, slash) ||
    !JS.strictEqual(questionMark, -1) && JS.greaterThan(colon, questionMark) ||
    !JS.strictEqual(numberSign, -1) && JS.greaterThan(colon, numberSign) ||
    JS.invoke(safeProtocol, "test", JS.invoke(value, "slice", 0, colon)).truthy()
  ) {
    return value;
  }
  return "";
}

