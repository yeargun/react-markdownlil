import { Array, Error, TypeError, isFn } from "./host.lil";

// trough@2: `run` feeds values through the middleware in order; `wrap` adapts one middleware
// (sync return, returned promise, or a `done` callback) to a node-style callback.

JsValue wrap(JsValue middleware, JsValue callback) {
  bool called = false;
  JsValue done = JS.staticRest((JsValue output) => {
    if (!called) {
      called = true;
      JS.apply(callback, JS.undefined(), output);
    }
    return JS.undefined();
  });
  JsValue then = (JsValue value) => {
    JsValue? nothing = null;
    return JS.call(done, JS.undefined(), nothing, value);
  };
  return JS.staticRest((JsValue args) => {
    JsValue parameters = JS.invoke(Array, "from", args);
    bool fnExpectsCallback = JS.number(JS.get(middleware, "length")) > parameters.length;
    if (fnExpectsCallback) JS.invoke(parameters, "push", done);
    JsValue result = JS.undefined();
    try {
      result = JS.apply(middleware, JS.undefined(), parameters);
    } catch (JsValue exception) {
      if (fnExpectsCallback && called) throw exception;
      return JS.call(done, JS.undefined(), exception);
    }
    if (!fnExpectsCallback) {
      JsValue resultThen = JS.and(result, JS.get(result, "then"));
      if (resultThen.truthy() && isFn(JS.get(result, "then"))) {
        JS.invoke(result, "then", then, done);
      } else if (JS.invoke(JS.get(Error, "prototype"), "isPrototypeOf", result).truthy()) {
        JS.call(done, JS.undefined(), result);
      } else {
        JS.call(then, JS.undefined(), result);
      }
    }
    return JS.undefined();
  });
}

// `[null, ...list]`
JsValue withNull(JsValue list) {
  JsValue? nothing = null;
  return JS.invoke(JS.array(nothing), "concat", list);
}

export JsValue trough() {
  JsValue fns = JS.array();
  JsValue pipeline = JS.undefined();
  pipeline = JS.object(
    "run", JS.staticRest((JsValue args) => {
      JsValue values = JS.invoke(Array, "from", args);
      float middlewareIndex = -1;
      JsValue callback = JS.invoke(values, "pop");
      if (!isFn(callback)) {
        throw JS.construct(TypeError, "Expected function as last argument, not " + callback);
      }
      JsValue next = JS.undefined();
      next = JS.staticRest((JsValue nextArgs) => {
        middlewareIndex++;
        JsValue fn = fns[middlewareIndex];
        JsValue error = nextArgs[0];
        if (error.truthy()) {
          return JS.call(callback, JS.undefined(), error);
        }
        JsValue output = JS.invoke(JS.invoke(Array, "from", nextArgs), "slice", 1.0);
        for (float index = 0; index < values.length; index++) {
          if (JS.isNullish(output[index])) output[index] = values[index];
        }
        values = output;
        if (fn.truthy()) {
          JS.apply(wrap(fn, next), JS.undefined(), output);
        } else {
          JS.apply(callback, JS.undefined(), withNull(output));
        }
        return JS.undefined();
      });
      JS.apply(next, JS.undefined(), withNull(values));
      return JS.undefined();
    }),
    "use", (JsValue middelware) => {
      if (!isFn(middelware)) {
        throw JS.construct(TypeError, "Expected `middelware` to be a function, not " + middelware);
      }
      JS.invoke(fns, "push", middelware);
      return pipeline;
    }
  );
  return pipeline;
}
