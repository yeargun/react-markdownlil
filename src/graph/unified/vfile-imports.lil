import { JSON, Object, TypeError, globalThis } from "./host.lil";

// vfile's imports under every condition but `node`: lib/minpath.browser.js,
// lib/minproc.browser.js and lib/minurl.browser.js of vfile@6.0.3. The default
// build (every runtime without `node`: browsers, workers, edge, React Native)
// copies this file over src/vfile-imports.lil, so `./host.lil` is src/host.lil;
// the Node build keeps src/vfile-imports.lil (node:path, node:process, node:url).

extern class VFileUrlView {
  JsValue href;
  JsValue protocol;
  JsValue auth;
  JsValue hostname;
  JsValue pathname;
}

// ---------------------------------------------------------------- minpath (browser)

bool isSlash(JsValue path, float index) {
  return JS.strictEqual(JS.invoke(path, "codePointAt", index), 47.0);
}

void assertPath(JsValue path) {
  if (!(path is string)) {
    throw JS.construct(TypeError, "Path must be a string. Received " + JS.invoke(JSON, "stringify", path));
  }
}

export JsValue basename(JsValue path, JsValue extname) {
  float start = 0;
  float end = -1;
  float index = path.length;
  bool seenNonSlash = false;
  if (JS.isUndefined(extname) || extname.length == 0.0 || extname.length > path.length) {
    while (index > 0) {
      index--;
      if (isSlash(path, index)) {
        if (seenNonSlash) {
          start = index + 1;
          break;
        }
      } else if (end < 0) {
        seenNonSlash = true;
        end = index + 1;
      }
    }
    return if (end < 0) { "" } else { JS.invoke(path, "slice", start, end) };
  }
  if (JS.strictEqual(extname, path)) return "";
  float firstNonSlashEnd = -1;
  float extnameIndex = extname.length - 1;
  while (index > 0) {
    index--;
    if (isSlash(path, index)) {
      if (seenNonSlash) {
        start = index + 1;
        break;
      }
    } else {
      if (firstNonSlashEnd < 0) {
        seenNonSlash = true;
        firstNonSlashEnd = index + 1;
      }
      if (extnameIndex > -1) {
        if (JS.strictEqual(JS.invoke(path, "codePointAt", index), JS.invoke(extname, "codePointAt", extnameIndex))) {
          extnameIndex--;
          if (extnameIndex < 0) end = index;
        } else {
          extnameIndex = -1;
          end = firstNonSlashEnd;
        }
      }
    }
  }
  if (start == end) {
    end = firstNonSlashEnd;
  } else if (end < 0) {
    end = path.length;
  }
  return JS.invoke(path, "slice", start, end);
}

export JsValue dirname(JsValue path) {
  if (path.length == 0.0) return ".";
  float end = -1;
  float index = path.length;
  bool unmatchedSlash = false;
  while (index > 1) {
    index--;
    if (isSlash(path, index)) {
      if (unmatchedSlash) {
        end = index;
        break;
      }
    } else {
      unmatchedSlash = true;
    }
  }
  return if (end < 0) {
    if (isSlash(path, 0)) { "/" } else { "." }
  } else {
    if (end == 1 && isSlash(path, 0)) { "//" } else { JS.invoke(path, "slice", 0.0, end) }
  };
}

export JsValue extname(JsValue path) {
  float index = path.length;
  float end = -1;
  float startPart = 0;
  float startDot = -1;
  float preDotState = 0;
  bool unmatchedSlash = false;
  while (index > 0) {
    index--;
    JsValue code = JS.invoke(path, "codePointAt", index);
    if (JS.strictEqual(code, 47.0)) {
      if (unmatchedSlash) {
        startPart = index + 1;
        break;
      }
      continue;
    }
    if (end < 0) {
      unmatchedSlash = true;
      end = index + 1;
    }
    if (JS.strictEqual(code, 46.0)) {
      if (startDot < 0) {
        startDot = index;
      } else {
        preDotState = 1;
      }
    } else if (startDot > -1) {
      preDotState = -1;
    }
  }
  return if (startDot < 0 || end < 0 || preDotState == 0 || preDotState == 1 && startDot == end - 1 && startDot == startPart + 1) {
    ""
  } else {
    JS.invoke(path, "slice", startDot, end)
  };
}

JsValue normalizeString(JsValue path, bool allowAboveRoot) {
  JsValue result = "";
  float lastSegmentLength = 0;
  float lastSlash = -1;
  float dots = 0;
  JsValue code = JS.undefined();
  for (float index = 0; index <= path.length; index++) {
    if (index < path.length) {
      code = JS.invoke(path, "codePointAt", index);
    } else if (JS.strictEqual(code, 47.0)) {
      break;
    } else {
      code = 47.0;
    }
    if (JS.strictEqual(code, 47.0)) {
      if (lastSlash != index - 1 && dots != 1) {
        if (dots == 2) {
          if (result.length < 2 || lastSegmentLength != 2 || !JS.strictEqual(JS.invoke(result, "codePointAt", result.length - 1), 46.0) || !JS.strictEqual(JS.invoke(result, "codePointAt", result.length - 2), 46.0)) {
            if (result.length > 2) {
              float lastSlashIndex = JS.number(JS.invoke(result, "lastIndexOf", "/"));
              if (lastSlashIndex != result.length - 1) {
                if (lastSlashIndex < 0) {
                  result = "";
                  lastSegmentLength = 0;
                } else {
                  result = JS.invoke(result, "slice", 0.0, lastSlashIndex);
                  lastSegmentLength = result.length - 1 - JS.number(JS.invoke(result, "lastIndexOf", "/"));
                }
                lastSlash = index;
                dots = 0;
                continue;
              }
            } else if (result.length > 0) {
              result = "";
              lastSegmentLength = 0;
              lastSlash = index;
              dots = 0;
              continue;
            }
          }
          if (allowAboveRoot) {
            result = if (result.length > 0) { JS.add(result, "/..") } else { ".." };
            lastSegmentLength = 2;
          }
        } else {
          JsValue segment = JS.invoke(path, "slice", lastSlash + 1, index);
          result = if (result.length > 0) { JS.add(JS.add(result, "/"), segment) } else { segment };
          lastSegmentLength = index - lastSlash - 1;
        }
      }
      lastSlash = index;
      dots = 0;
    } else if (JS.strictEqual(code, 46.0) && dots > -1) {
      dots++;
    } else {
      dots = -1;
    }
  }
  return result;
}

export JsValue join(JsValue left, JsValue right) {
  assertPath(left);
  assertPath(right);
  JsValue joined = if (!left.truthy()) { right } else { if (right.truthy()) { JS.add(JS.add(left, "/"), right) } else { left } };
  if (!joined.truthy()) return ".";
  bool absolute = isSlash(joined, 0);
  JsValue value = normalizeString(joined, !absolute);
  if (value.length == 0.0 && !absolute) value = ".";
  if (value.length > 0 && isSlash(joined, joined.length - 1)) value = JS.add(value, "/");
  return if (absolute) { JS.add("/", value) } else { value };
}

// ---------------------------------------------------------------- minurl (browser)

void throwCode(string message, string code) {
  throw JS.invoke(Object, "assign", JS.construct(TypeError, message), JS.object("code", code));
}

export JsValue urlToPath(JsValue value) {
  VFileUrlView url = JS.assume(value);
  if (!JS.strictEqual(url.protocol, "file:")) {
    throwCode("The URL must be of scheme file", "ERR_INVALID_URL_SCHEME");
  }
  if (!JS.strictEqual(url.hostname, "")) {
    throwCode("File URL host must be \"localhost\" or empty on darwin", "ERR_INVALID_FILE_URL_HOST");
  }
  JsValue pathname = url.pathname;
  for (float index = 0; index < pathname.length; index++) {
    if (JS.strictEqual(JS.invoke(pathname, "codePointAt", index), 37.0) && JS.strictEqual(JS.invoke(pathname, "codePointAt", index + 1), 50.0)) {
      JsValue third = JS.invoke(pathname, "codePointAt", index + 2);
      if (JS.strictEqual(third, 70.0) || JS.strictEqual(third, 102.0)) {
        throwCode("File URL path must not include encoded / characters", "ERR_INVALID_FILE_URL_PATH");
      }
    }
  }
  return JS.invoke(globalThis, "decodeURIComponent", pathname);
}

// ---------------------------------------------------------------- minproc (browser)

export JsValue cwd() {
  return "/";
}

// minpath's `sep`.
export JsValue sep() {
  return "/";
}
