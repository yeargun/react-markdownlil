import { Object, Symbol } from "./host.lil";

export JsValue hasOwnProperty = JS.get(JS.object(), "hasOwnProperty");

// is-plain-obj@4
export bool isPlainObj(JsValue value) {
  if (JS.typeOf(value) != "object" || JS.isNullish(value)) return false;
  JsValue prototype = JS.invoke(Object, "getPrototypeOf", value);
  return (JS.isNullish(prototype) || JS.strictEqual(prototype, JS.get(Object, "prototype")) || JS.isNullish(JS.invoke(Object, "getPrototypeOf", prototype))) &&
    !JS.in(JS.get(Symbol, "toStringTag"), value) && !JS.in(JS.get(Symbol, "iterator"), value);
}

// extend@3's own check: a `[object Object]` whose constructor is Object-like and whose last key is own.
export bool isPlainObjectExtend(JsValue obj) {
  if (!obj.truthy() || JS.call(JS.get(JS.get(Object, "prototype"), "toString"), obj) != "[object Object]") return false;
  JsValue ctor = JS.get(obj, "constructor");
  if (ctor.truthy() && !JS.call(hasOwnProperty, obj, "constructor").truthy()) {
    JsValue ctorPrototype = JS.get(ctor, "prototype");
    if (!ctorPrototype.truthy() || !JS.call(hasOwnProperty, ctorPrototype, "isPrototypeOf").truthy()) return false;
  }
  JsValue last = JS.undefined();
  for (string key in obj) {
    last = key;
  }
  return JS.isUndefined(last) || JS.call(hasOwnProperty, obj, last).truthy();
}
