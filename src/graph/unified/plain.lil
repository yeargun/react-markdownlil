import { HAS_OWN, Object, Symbol, TO_STRING, protoOf } from "./host.lil";

export bool isPlainObj(JsValue value) {
  if (JS.typeOf(value) != "object" || JS.isNullish(value)) {
    return false;
  }
  JsValue prototype = protoOf(value);
  bool protoOk = JS.isNullish(prototype) || JS.strictEqual(prototype, JS.get(Object, "prototype"));
  if (!protoOk) {
    protoOk = JS.isNullish(protoOf(prototype));
  }
  if (!protoOk) {
    return false;
  }
  if (JS.in(JS.get(Symbol, "toStringTag"), value)) {
    return false;
  }
  if (JS.in(JS.get(Symbol, "iterator"), value)) {
    return false;
  }
  return true;
}

export bool isPlainObjectExtend(JsValue obj) {
  if (!obj.truthy()) {
    return false;
  }
  JsValue tag = JS.call(TO_STRING, obj);
  if (JS.string(tag) != "[object Object]") {
    return false;
  }
  bool hasOwnConstructor = JS.call(HAS_OWN, obj, "constructor").truthy();
  JsValue ctor = JS.get(obj, "constructor");
  bool hasIsPrototypeOf = false;
  if (ctor.truthy()) {
    JsValue constructorPrototype = JS.get(ctor, "prototype");
    if (constructorPrototype.truthy()) {
      hasIsPrototypeOf = JS.call(HAS_OWN, JS.get(ctor, "prototype"), "isPrototypeOf").truthy();
    }
  }
  if (ctor.truthy() && !hasOwnConstructor && !hasIsPrototypeOf) {
    return false;
  }
  string last = "";
  bool saw = false;
  for (string key in obj) {
    last = key;
    saw = true;
  }
  if (!saw) {
    return true;
  }
  return JS.call(HAS_OWN, obj, last).truthy();
}
