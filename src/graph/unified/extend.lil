import { Object } from "./host.lil";
import { hasOwnProperty, isPlainObjectExtend } from "./plain.lil";

JsValue getProperty(JsValue obj, string name) {
  if (name == "__proto__") {
    if (!JS.call(hasOwnProperty, obj, name).truthy()) return JS.undefined();
    return JS.get(JS.invoke(Object, "getOwnPropertyDescriptor", obj, name), "value");
  }
  return JS.get(obj, name);
}

// extend@3 with `deep = true` and one source: `extend(true, target, source)`.
export JsValue extendWith(JsValue target, JsValue source) {
  if (JS.isNullish(target) || JS.typeOf(target) != "object" && JS.typeOf(target) != "function") target = JS.object();
  if (!JS.isNullish(source)) {
    for (string name in source) {
      JsValue src = getProperty(target, name);
      JsValue copy = getProperty(source, name);
      if (!JS.strictEqual(target, copy)) {
        JsValue value = copy;
        if (copy.truthy() && (isPlainObjectExtend(copy) || copy.isArray())) {
          JsValue clone = if (copy.isArray()) {
            if (src.truthy() && src.isArray()) { src } else { JS.array() }
          } else {
            if (src.truthy() && isPlainObjectExtend(src)) { src } else { JS.object() }
          };
          value = extendWith(clone, copy);
        } else if (JS.isUndefined(copy)) {
          continue;
        }
        if (name == "__proto__") {
          JS.invoke(Object, "defineProperty", target, name, JS.object("enumerable", true, "configurable", true, "value", value, "writable", true));
        } else {
          JS.set(target, name, value);
        }
      }
    }
  }
  return target;
}
