import {
  Array,
  Error,
  Object,
  Promise,
  String,
  TypeError,
  bail,
  defineMembers,
  finishClass,
  isFn,
  looksLikeAValue,
  requireNew
} from "./host.lil";
import { hasOwnProperty, isPlainObj } from "./plain.lil";
import { extendWith } from "./extend.lil";
import { trough } from "./trough.lil";
import { VFile } from "./vfile.lil";

// unified@11 over host objects: `Processor` is a callable instance (`processor()` copies it), its
// methods live on `Processor.prototype` with class-method attributes, and plugins read and write the
// members below by name.
export extern class ProcessorApi {
  JsValue copy;
  JsValue use;
  JsValue parse;
  JsValue run;
  JsValue runSync;
  JsValue stringify;
  JsValue process;
  JsValue processSync;
  JsValue data;
  JsValue freeze;
  JsValue attachers;
  JsValue parser;
  JsValue compiler;
  JsValue Parser;
  JsValue Compiler;
  JsValue namespace;
  JsValue frozen;
  JsValue freezeIndex;
  JsValue transformers;
}

extern class UnifiedPresetView {
  JsValue plugins;
  JsValue settings;
}

extern class UnifiedFileView {
  JsValue value;
  JsValue result;
}

bool looksLikeAVFile(JsValue value) {
  return value.truthy() && JS.typeOf(value) == "object" && JS.in("message", value) && JS.in("messages", value);
}

JsValue asVFile(JsValue value) {
  return if (looksLikeAVFile(value)) { value } else { JS.construct(VFile, value) };
}

void assertParser(string name, JsValue value) {
  if (!isFn(value)) {
    throw JS.construct(TypeError, "Cannot `" + name + "` without `parser`");
  }
}

void assertCompiler(string name, JsValue value) {
  if (!isFn(value)) {
    throw JS.construct(TypeError, "Cannot `" + name + "` without `compiler`");
  }
}

void assertUnfrozen(string name, JsValue frozen) {
  if (frozen.truthy()) {
    throw JS.construct(
      Error,
      "Cannot call `" +
        name +
        "` on a frozen processor.\nCreate a new processor first, by calling it: use `processor()` instead of `processor`."
    );
  }
}

void assertNode(JsValue node) {
  if (!isPlainObj(node) || !(JS.get(node, "type") is string)) {
    throw JS.construct(TypeError, "Expected node, got `" + node + "`");
  }
}

void assertDone(string name, string asyncName, bool complete) {
  if (!complete) {
    throw JS.construct(Error, "`" + name + "` finished async. Use `" + asyncName + "` instead");
  }
}

// `use(value, ...parameters)` (top) and the per-item `add(value)` of a list share one dispatch:
// a list at the top level is a list of plugins, inside a list it is `[plugin, ...parameters]`.
void addValue(JsValue attachers, JsValue namespace, JsValue value, JsValue parameters, bool top) {
  if (isFn(value)) {
    addPlugin(attachers, value, parameters);
  } else if (JS.typeOf(value) == "object") {
    if (!value.isArray()) {
      UnifiedPresetView preset = JS.assume(value);
      if (!JS.in("plugins", value) && !JS.in("settings", value)) {
        throw JS.construct(
          Error,
          "Expected usable value but received an empty preset, which is probably a mistake: presets typically come with `plugins` and sometimes with `settings`, but this has neither"
        );
      }
      addList(attachers, namespace, preset.plugins);
      if (preset.settings.truthy()) {
        UnifiedPresetView settings = JS.assume(namespace);
        settings.settings = extendWith(settings.settings, preset.settings);
      }
    } else if (top) {
      addList(attachers, namespace, value);
    } else {
      addPlugin(attachers, value[0], JS.invoke(value, "slice", 1.0));
    }
  } else {
    throw JS.construct(TypeError, "Expected usable value, not `" + value + "`");
  }
}

void addList(JsValue attachers, JsValue namespace, JsValue plugins) {
  if (!JS.isNullish(plugins)) {
    if (!plugins.isArray()) {
      throw JS.construct(TypeError, "Expected a list of plugins, not `" + plugins + "`");
    }
    for (float index = 0; index < plugins.length; index++) {
      addValue(attachers, namespace, plugins[index], JS.array(), false);
    }
  }
}

void addPlugin(JsValue attachers, JsValue plugin, JsValue parameters) {
  float entryIndex = -1;
  for (float index = 0; index < attachers.length; index++) {
    if (JS.strictEqual(attachers[index][0], plugin)) {
      entryIndex = index;
      break;
    }
  }
  if (entryIndex > -1) {
    if (parameters.length == 0.0) return;
    JsValue primary = parameters[0];
    JsValue currentPrimary = attachers[entryIndex][1];
    if (isPlainObj(currentPrimary) && isPlainObj(primary)) parameters[0] = extendWith(currentPrimary, primary);
  }
  JsValue entry = JS.invoke(JS.array(plugin), "concat", parameters);
  if (entryIndex < 0) {
    JS.invoke(attachers, "push", entry);
  } else {
    attachers[entryIndex] = entry;
  }
}

JsValue executeWith(JsValue executor, JsValue done) {
  return if (done.truthy()) { JS.call(executor, JS.undefined(), JS.undefined(), done) } else { JS.construct(Promise, executor) };
}

JsValue Processor = JS.method0((JsValue self) => {
  requireNew(self, "Processor");
  // CallableInstance: calling the processor applies the prototype's `copy` (as it was at construction).
  JsValue proto = JS.get(Processor, "prototype");
  JsValue copy = JS.get(proto, "copy");
  JsValue processor = JS.undefined();
  processor = JS.staticRest((JsValue parameters) => JS.apply(copy, processor, parameters));
  return JS.invoke(Object, "assign", JS.invoke(Object, "setPrototypeOf", processor, proto), JS.object(
    "Compiler", JS.undefined(),
    "Parser", JS.undefined(),
    "attachers", JS.array(),
    "compiler", JS.undefined(),
    "freezeIndex", -1.0,
    "frozen", JS.undefined(),
    "namespace", JS.object(),
    "parser", JS.undefined(),
    "transformers", trough()
  ));
});
finishClass(Processor, "Processor");

JsValue dataMethod = JS.methodRest((JsValue self, JsValue parameters) => {
  ProcessorApi processor = JS.assume(self);
  JsValue key = parameters[0];
  if (key is string) {
    if (parameters.length == 2.0) {
      assertUnfrozen("data", processor.frozen);
      JS.set(processor.namespace, key, parameters[1]);
      return self;
    }
    return JS.or(JS.and(JS.call(hasOwnProperty, processor.namespace, key), JS.get(processor.namespace, key)), JS.undefined());
  }
  if (key.truthy()) {
    assertUnfrozen("data", processor.frozen);
    processor.namespace = key;
    return self;
  }
  return processor.namespace;
});

JsValue useMethod = JS.methodRest((JsValue self, JsValue parameters) => {
  ProcessorApi processor = JS.assume(self);
  JsValue attachers = processor.attachers;
  JsValue namespace = processor.namespace;
  assertUnfrozen("use", processor.frozen);
  JsValue value = parameters[0];
  if (!JS.isNullish(value)) {
    addValue(attachers, namespace, value, JS.invoke(JS.invoke(Array, "from", parameters), "slice", 1.0), true);
  }
  return self;
});

defineMembers(JS.object(
  "copy", JS.method0((JsValue self) => {
    ProcessorApi processor = JS.assume(self);
    JsValue destination = JS.construct(Processor);
    JsValue attachers = processor.attachers;
    for (float index = 0; index < attachers.length; index++) {
      JS.apply(JS.get(destination, "use"), destination, attachers[index]);
    }
    JS.invoke(destination, "data", extendWith(JS.object(), processor.namespace));
    return destination;
  }),
  "data", dataMethod,
  "freeze", JS.method0((JsValue self) => {
    ProcessorApi processor = JS.assume(self);
    if (processor.frozen.truthy()) return self;
    while (true) {
      float index = JS.number(processor.freezeIndex) + 1;
      processor.freezeIndex = index;
      if (!(index < processor.attachers.length)) break;
      JsValue entry = processor.attachers[index];
      JsValue options = JS.invoke(entry, "slice", 1.0);
      if (JS.strictEqual(options[0], false)) continue;
      if (JS.strictEqual(options[0], true)) options[0] = JS.undefined();
      JsValue transformer = JS.apply(entry[0], self, options);
      if (isFn(transformer)) JS.invoke(processor.transformers, "use", transformer);
    }
    processor.frozen = true;
    processor.freezeIndex = 1.0 / 0.0;
    return self;
  }),
  "parse", JS.method1((JsValue self, JsValue file) => {
    ProcessorApi processor = JS.assume(self);
    JS.invoke(self, "freeze");
    JsValue realFile = asVFile(file);
    JsValue parser = JS.or(processor.parser, processor.Parser);
    assertParser("parse", parser);
    return JS.call(parser, JS.undefined(), JS.call(String, JS.undefined(), realFile), realFile);
  }),
  "process", JS.method2((JsValue self, JsValue file, JsValue done) => {
    ProcessorApi processor = JS.assume(self);
    JS.invoke(self, "freeze");
    assertParser("process", JS.or(processor.parser, processor.Parser));
    assertCompiler("process", JS.or(processor.compiler, processor.Compiler));
    return executeWith((JsValue resolve, JsValue reject) => {
      JsValue realFile = asVFile(file);
      JsValue parseTree = JS.invoke(self, "parse", realFile);
      JS.invoke(self, "run", parseTree, realFile, (JsValue error, JsValue tree, JsValue outFile) => {
        if (error.truthy() || !tree.truthy() || !outFile.truthy()) {
          JS.call(reject, JS.undefined(), error);
        } else {
          UnifiedFileView output = JS.assume(outFile);
          JsValue compileResult = JS.invoke(self, "stringify", tree, outFile);
          if (looksLikeAValue(compileResult)) {
            output.value = compileResult;
          } else {
            output.result = compileResult;
          }
          if (resolve.truthy()) {
            JS.call(resolve, JS.undefined(), outFile);
          } else {
            JS.call(done, JS.undefined(), JS.undefined(), outFile);
          }
        }
        return JS.undefined();
      });
      return JS.undefined();
    }, done);
  }),
  "processSync", JS.method1((JsValue self, JsValue file) => {
    ProcessorApi processor = JS.assume(self);
    bool complete = false;
    JsValue result = JS.undefined();
    JS.invoke(self, "freeze");
    assertParser("processSync", JS.or(processor.parser, processor.Parser));
    assertCompiler("processSync", JS.or(processor.compiler, processor.Compiler));
    JS.invoke(self, "process", file, (JsValue error, JsValue outFile) => {
      complete = true;
      bail(error);
      result = outFile;
      return JS.undefined();
    });
    assertDone("processSync", "process", complete);
    return result;
  }),
  "run", JS.method3((JsValue self, JsValue tree, JsValue file, JsValue done) => {
    ProcessorApi processor = JS.assume(self);
    assertNode(tree);
    JS.invoke(self, "freeze");
    JsValue transformers = processor.transformers;
    if (!done.truthy() && isFn(file)) {
      done = file;
      file = JS.undefined();
    }
    return executeWith((JsValue resolve, JsValue reject) => {
      JS.invoke(transformers, "run", tree, asVFile(file), (JsValue error, JsValue outputTree, JsValue outFile) => {
        JsValue resultingTree = JS.or(outputTree, tree);
        if (error.truthy()) {
          JS.call(reject, JS.undefined(), error);
        } else if (resolve.truthy()) {
          JS.call(resolve, JS.undefined(), resultingTree);
        } else {
          JS.call(done, JS.undefined(), JS.undefined(), resultingTree, outFile);
        }
        return JS.undefined();
      });
      return JS.undefined();
    }, done);
  }),
  "runSync", JS.method2((JsValue self, JsValue tree, JsValue file) => {
    bool complete = false;
    JsValue result = JS.undefined();
    JS.invoke(self, "run", tree, file, (JsValue error, JsValue outTree) => {
      bail(error);
      result = outTree;
      complete = true;
      return JS.undefined();
    });
    assertDone("runSync", "run", complete);
    return result;
  }),
  "stringify", JS.method2((JsValue self, JsValue tree, JsValue file) => {
    ProcessorApi processor = JS.assume(self);
    JS.invoke(self, "freeze");
    JsValue realFile = asVFile(file);
    JsValue compiler = JS.or(processor.compiler, processor.Compiler);
    assertCompiler("stringify", compiler);
    assertNode(tree);
    return JS.call(compiler, JS.undefined(), tree, realFile);
  }),
  "use", useMethod
), JS.get(Processor, "prototype"));
JS.invoke(Object, "defineProperty", dataMethod, "length", JS.object("value", 2.0));
JS.invoke(Object, "defineProperty", useMethod, "length", JS.object("value", 1.0));

JsValue unifiedValue = JS.invoke(JS.construct(Processor), "freeze");

export JsValue unified = unifiedValue;
export JsValue VFileRuntime = VFile;
export JsValue ProcessorRuntime = Processor;
