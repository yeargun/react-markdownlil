import { Array, Error, JSON, Number, Object, Promise, String, Symbol, TextDecoder, TypeError, globalThis } from "../../host.lil";
export { Array, Error, JSON, Number, Object, Promise, String, Symbol, TextDecoder, TypeError, globalThis };

export bool isFn(JsValue value) {
  return JS.typeOf(value) == "function";
}

export bool isUint8Array(JsValue value) {
  return value.truthy() && JS.typeOf(value) == "object" && JS.in("byteLength", value) && JS.in("byteOffset", value);
}

export bool looksLikeAValue(JsValue value) {
  return value is string || isUint8Array(value);
}

export void bail(JsValue error) {
  if (error.truthy()) {
    throw error;
  }
}

// `class X` refuses a call without `new`; the host-callable constructors here do the same.
export void requireNew(JsValue self, string name) {
  if (JS.isUndefined(self)) {
    throw JS.construct(TypeError, "Class constructor " + name + " cannot be invoked without 'new'");
  }
}

// A function's own `name` is configurable; redefining only its value keeps the other attributes.
export void nameFunction(JsValue fn, JsValue name) {
  JS.invoke(Object, "defineProperty", fn, "name", JS.object("value", name));
}

// Class-member semantics on `proto`, in table order: a function becomes a method named after its key
// (non-enumerable, writable, configurable); a `{get, set}` pair becomes an accessor whose functions are
// named `get key` / `set key`.
export void defineMembers(JsValue members, JsValue proto) {
  for (string key in members) {
    JsValue member = JS.get(members, key);
    JsValue descriptor = member;
    if (isFn(member)) {
      nameFunction(member, key);
      descriptor = JS.object("writable", true, "value", member);
    } else {
      nameFunction(JS.get(member, "get"), "get " + key);
      nameFunction(JS.get(member, "set"), "set " + key);
    }
    JS.set(descriptor, "configurable", true);
    JS.invoke(Object, "defineProperty", proto, key, descriptor);
  }
}

// What `class Name` gives its constructor: the name, and a non-writable `prototype`.
export void finishClass(JsValue ctor, string name) {
  nameFunction(ctor, name);
  JS.invoke(Object, "defineProperty", ctor, "prototype", JS.object("writable", false));
}
