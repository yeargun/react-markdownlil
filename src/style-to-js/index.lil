// style-to-js@1.1.21 (with style-to-object@1.0.14 and inline-style-parser@0.2.7) as hast-util-to-jsx-runtime
// calls it with `ignoreInvalidStyle`: `styleToJs(value, {reactCompat: true})` on a string, and `{}` when that
// throws. The parser is upstream's: the same regular expressions, applied in the same order to the rest of the
// input; a parse error only needs to throw.
import { camelcase } from "../property-information/lib/find.lil";

extern JsValue RegExp;

JsValue propertyPattern = JS.construct(RegExp, "^(\\*?[-#/*\\\\\\w]+(\\[[0-9a-z_-]+\\])?)\\s*");
JsValue colon = JS.construct(RegExp, "^:\\s*");
JsValue valuePattern = JS.construct(RegExp, "^((?:'(?:\\\\'|.)*?'|\"(?:\\\\\"|.)*?\"|\\([^)]*?\\)|[^};])+)");
JsValue semicolon = JS.construct(RegExp, "^[;\\s]*");
JsValue comments = JS.construct(RegExp, "\\/\\*[^*]*\\*+([^/*][^*]*\\*+)*\\/", "g");
JsValue customProperty = JS.construct(RegExp, "^--[a-zA-Z0-9_-]+$");
JsValue msPrefix = JS.construct(RegExp, "^-ms-");
JsValue hyphen = JS.construct(RegExp, "-[a-z]", "g");

export JsValue styleToJs(JsValue style) {
  JsValue output = object {};
  JsValue rest = style;

  // Consume `pattern` at the start of the rest; the match, or null.
  auto eat = (JsValue pattern) => {
    JsValue found = JS.invoke(pattern, "exec", rest);
    if (found.truthy()) {
      rest = JS.invoke(rest, "slice", JS.get(found[0], "length"));
    }
    return found;
  };
  // One comment at the start of the rest (an unclosed one throws); whether there was one.
  auto comment = () => {
    if (!JS.strictEqual(JS.invoke(rest, "charAt", 0), "/") || !JS.strictEqual(JS.invoke(rest, "charAt", 1), "*")) {
      return false;
    }
    JsValue end = JS.invoke(rest, "indexOf", "*/", 2);
    if (JS.strictEqual(end, -1)) {
      throw rest;
    }
    rest = JS.invoke(JS.invoke(rest, "slice", JS.add(end, 2)), "trimStart");
    return true;
  };

  try {
    if (rest.truthy()) {
      rest = JS.invoke(rest, "trimStart");
      while (comment()) {}
      JsValue property = eat(propertyPattern);
      while (property.truthy()) {
        comment();
        if (!eat(colon).truthy()) {
          throw rest;
        }
        JsValue value = eat(valuePattern);
        JsValue name = JS.invoke(JS.invoke(property[0], "replace", comments, ""), "trim");
        value = if (value.truthy()) { JS.invoke(JS.invoke(value[0], "replace", comments, ""), "trim") } else { "" };
        rest = JS.invoke(rest, "trimStart");
        eat(semicolon);
        if (name.truthy() && value.truthy()) {
          if (JS.invoke(name, "includes", "-").truthy() && !JS.invoke(customProperty, "test", name).truthy()) {
            name = JS.invoke(JS.invoke(JS.invoke(name, "toLowerCase"), "replace", msPrefix, "ms-"), "replace", hyphen, camelcase);
          }
          output[name] = value;
        }
        while (comment()) {}
        property = eat(propertyPattern);
      }
    }
  } catch {
    return object {};
  }
  return output;
}
