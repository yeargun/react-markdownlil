// unist-util-visit@5.1.0 `visit(tree, visitor)` for react-markdown's one visitor, which returns the index to
// continue at (a number) or nothing: upstream's EXIT and SKIP never occur, and only the direct parent of a
// node is observable. Call as `visit(tree, undefined, visitor)`.
export JsValue visit(JsValue node, JsValue parent, func(JsValue, JsValue, JsValue)->JsValue visitor) {
  JsValue result = visitor(node, JS.and(parent, JS.invoke(JS.get(parent, "children"), "indexOf", node)), parent);
  if (JS.in("children", node) && JS.get(node, "children").truthy()) {
    JsValue offset = 0;
    while (JS.greaterThan(offset, -1) && JS.lessThan(offset, JS.get(JS.get(node, "children"), "length"))) {
      JsValue next = visit(JS.get(node, "children")[offset], node, visitor);
      offset = if (JS.typeOf(next) == "number") { next } else { JS.add(offset, 1) };
    }
  }
  return result;
}
