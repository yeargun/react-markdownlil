{
  "name": "@itslil/react-markdown",
  "version": "10.1.0",
  "description": "react-markdown reimplemented in LilScript",
  "keywords": [
    "react-markdown",
    "markdown",
    "react",
    "remark",
    "rehype",
    "lilscript",
    "itslil"
  ],
  "homepage": "https://yeargun.github.io/react-markdownlil/",
  "bugs": "https://github.com/yeargun/react-markdownlil/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeargun/react-markdownlil.git"
  },
  "license": "MIT",
  "author": "yeargun",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/react-markdown.cjs",
  "module": "./dist/react-markdown.esm.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "development": {
        "import": "./dist/react-markdown.development.js",
        "require": "./dist/react-markdown.development.cjs",
        "default": "./dist/react-markdown.esm.js"
      },
      "import": "./dist/react-markdown.esm.js",
      "require": "./dist/react-markdown.cjs",
      "default": "./dist/react-markdown.esm.js"
    },
    "./closed": "./dist/react-markdown.closed.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "source-graph.lock.json",
    "src",
    "dist/react-markdown.esm.js",
    "dist/react-markdown.development.js",
    "dist/react-markdown.cjs",
    "dist/react-markdown.development.cjs",
    "dist/react-markdown.closed.js",
    "index.d.ts",
    "lib",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs --compile",
    "graph:lock": "node scripts/source-graph.mjs --write-lock",
    "graph:sync": "node scripts/source-graph.mjs --sync",
    "check:graph": "node scripts/source-graph.mjs --require-siblings",
    "check:reproducible": "node scripts/check-reproducible-build.mjs",
    "build:site": "node scripts/build-site.mjs",
    "generate:schema": "node scripts/generate-schema.mjs",
    "test": "node --conditions development --experimental-loader=./test/load-jsx.js --no-warnings --test test/*.test.mjs test/official/test.jsx && npm run check:types",
    "check:types": "tsc --noEmit --strict --preserveSymlinks --module node16 --moduleResolution node16 --target es2022 test/types.ts",
    "check:site": "npm run build:site && node --test test/site.test.mjs",
    "check:pack": "node scripts/check-pack.mjs && node scripts/check-local-graph.mjs && npm run check:graph",
    "measure:graph": "node scripts/measure-graph.mjs",
    "prepublishOnly": "npm test && npm run check:pack && npm run check:site"
  },
  "dependencies": {
    "@types/hast": "^3.0.0",
    "@types/mdast": "^4.0.0",
    "remark-rehype": "^11.0.0",
    "unified": "^11.0.0"
  },
  "peerDependencies": {
    "@types/react": ">=18",
    "react": ">=18"
  },
  "devDependencies": {
    "@itslil/katex": "0.16.22",
    "@itslil/rehype-katex": "7.0.2",
    "@itslil/remark-breaks": "4.0.1",
    "@itslil/remark-gfm": "4.0.2",
    "@itslil/remark-math": "6.0.1",
    "@testing-library/react": "^16.0.0",
    "concat-stream": "^2.0.0",
    "esbuild": "0.28.1",
    "global-jsdom": "^26.0.0",
    "hast-util-to-jsx-runtime": "2.3.6",
    "property-information": "7.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-starry-night": "^2.0.0",
    "remark-toc": "^9.0.0",
    "terser": "5.51.2",
    "typescript": "^5.0.0",
    "unist-util-visit": "5.1.0",
    "vfile": "6.0.3"
  }
}
