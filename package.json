{
  "name": "@itslil/react-markdown",
  "version": "10.1.0",
  "description": "react-markdown reimplemented in LilScript",
  "keywords": [
    "react-markdown",
    "markdown",
    "react",
    "remark",
    "rehype",
    "lilscript",
    "itslil"
  ],
  "homepage": "https://yeargun.github.io/react-markdownlil/",
  "bugs": "https://github.com/yeargun/react-markdownlil/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeargun/react-markdownlil.git"
  },
  "license": "MIT",
  "author": "yeargun",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/react-markdown.cjs",
  "module": "./dist/react-markdown.esm.js",
  "types": "./dist/react-markdown.d.ts",
  "unpkg": "./dist/react-markdown.umd.js",
  "jsdelivr": "./dist/react-markdown.umd.js",
  "exports": {
    ".": {
      "types": "./dist/react-markdown.d.ts",
      "import": "./dist/react-markdown.esm.js",
      "require": "./dist/react-markdown.cjs",
      "default": "./dist/react-markdown.esm.js"
    },
    "./closed": "./dist/react-markdown.closed.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist/react-markdown.esm.js",
    "dist/react-markdown.cjs",
    "dist/react-markdown.umd.js",
    "dist/react-markdown.closed.js",
    "dist/react-markdown.d.ts",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs --compile",
    "build:site": "node scripts/build-site.mjs",
    "test": "node --experimental-loader=./test/load-jsx.js --no-warnings --test test/*.test.mjs test/official/test.jsx",
    "check:site": "npm run build:site && node --test test/site.test.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "prepublishOnly": "npm test && npm run check:pack && npm run check:site"
  },
  "dependencies": {
    "@itslil/remark-parse": "11.0.1",
    "@itslil/remark-rehype": "11.1.3",
    "@itslil/unified": "11.0.6"
  },
  "peerDependencies": {
    "@types/react": ">=18",
    "react": ">=18"
  },
  "devDependencies": {
    "@itslil/katex": "0.16.23",
    "@itslil/rehype-katex": "7.0.2",
    "@itslil/remark-breaks": "4.0.1",
    "@itslil/remark-gfm": "4.0.2",
    "@itslil/remark-math": "6.0.1",
    "@testing-library/react": "^16.0.0",
    "concat-stream": "^2.0.0",
    "esbuild": "0.28.1",
    "global-jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-starry-night": "^2.0.0",
    "remark-toc": "^9.0.0"
  }
}
